{
  "name": "handbook-rag-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p prisma/tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "contract:lint": "redocly lint docs/hr-openapi.yaml",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@langchain/textsplitters": "^1.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "chromadb": "^3.5.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@redocly/cli": "^2.77.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
