# Copy this file to .env and fill in the values.

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Secrets ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any long random string. Admin requests must send it in the x-admin-key header.
ADMIN_API_KEY=

# --- ChromaDB ---
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=handbook-collection

# --- Browser access (CORS) ---
# Origins allowed to call the API from a browser (the React admin app), comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- Voice ---
# Max simultaneous voice calls, and how long a silent voice call may stay open (ms).
VOICE_MAX_SESSIONS=20
VOICE_IDLE_TIMEOUT_MS=120000

# --- Models ---
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.5-flash
CHAT_FALLBACK_MODEL=gemini-3.8-flash
LIVE_MODEL=gemini-3.8-live

# --- HR database (Postgres) ---
# From the root docker-compose.yml: service "hr-db", host port 5433.
DATABASE_URL=postgresql://hr:hr@localhost:5433/hr

# --- Employee login ---
# Signs login tokens. Any long random string, e.g.: openssl rand -hex 32
JWT_SECRET=
# How long a login token stays valid, in seconds.
JWT_TTL_SECONDS=3600
